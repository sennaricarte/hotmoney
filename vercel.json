{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/como-monetizar-um-hobby",
      "destination": "/como-monetizar-um-hobby-guia-completo",
      "permanent": true
    },
    {
      "source": "/aplicativos-de-renda-extra",
      "destination": "/renda-extra-com-aplicativos-guia-completo",
      "permanent": true
    },
    {
      "source": "/blog/:slug((?![0-9]+$)(?!$).*)",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/posts/:slug*",
      "destination": "/:slug*",
      "permanent": true
    },
    {
      "source": "/como-montar-um-servico-de-desentupimento(/)?",
      "destination": "/renda-extra",
      "statusCode": 308
    },
    {
      "source": "/ganhe-dinheiro-com-limpeza-de-calha(/)?",
      "destination": "/renda-extra",
      "statusCode": 308
    },
    {
      "source": "/controle-de-pragas(/)?",
      "destination": "/renda-extra",
      "statusCode": 308
    },
    {
      "source": "/desentupimento-industrial-o-guia-completo(/)?",
      "destination": "/renda-extra",
      "statusCode": 308
    },
    {
      "source": "/servicos-desentupimento-controle-ambiental-guia-essencial(/)?",
      "destination": "/renda-extra",
      "statusCode": 308
    },
    {
      "source": "/contratar-desentupidora(/)?",
      "destination": "/renda-extra",
      "statusCode": 308
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
